# Python environments and caches
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.ipynb_checkpoints/

# Packaging and coverage output
build/
dist/
*.egg-info/
.coverage
htmlcov/

# Editors and operating systems
.DS_Store
.idea/
.vscode/*
!.vscode/extensions.json

# LaTeX intermediate files
*.aux
*.bbl
*.bcf
*.blg
*.fdb_latexmk
*.fls
*.log
*.out
*.run.xml
*.synctex.gz
*.toc

# Local or generated data
data/raw/*
data/processed/*
!data/raw/.gitkeep
!data/processed/.gitkeep

# Local secrets and environment files
.env
.env.*
!.env.example

# LaTeX textbook build intermediates; the stable PDF is written to output/pdf.
textbook/build/

# Local renderings and other quality-assurance scratch files
tmp/
