# Copy to .env for an optional provider lab. .env is ignored by Git.
# Keep only the variables for the provider selected by your team.
MODEL_PROVIDER=
MODEL_IDENTIFIER=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
XAI_API_KEY=
MOONSHOT_API_KEY=
GOOGLE_API_KEY=
MISTRAL_API_KEY=

# A local server may use no upstream inference key, but still requires access
# control when reachable by other users or machines.
LOCAL_MODEL_BASE_URL=http://127.0.0.1:8001/v1
