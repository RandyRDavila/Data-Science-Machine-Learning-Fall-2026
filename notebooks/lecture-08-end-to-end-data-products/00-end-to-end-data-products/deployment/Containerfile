# Executable local teaching image. Pin this base by reviewed digest for production.
FROM ghcr.io/astral-sh/uv:0.12.6-python3.12-bookworm-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

WORKDIR /app
COPY pyproject.toml uv.lock ./
COPY src ./src
COPY notebooks/lecture-08-end-to-end-data-products/00-end-to-end-data-products/backend ./backend
RUN uv sync --locked --no-dev

USER 10001
EXPOSE 8080
CMD ["uv", "run", "--no-sync", "uvicorn", "app:app", "--app-dir", "backend", "--host", "0.0.0.0", "--port", "8080"]
