logging {
  level  = "info"
  format = "logfmt"
}

local.file_match "api_logs" {
  path_targets = [{
    "__path__"     = "/runtime/logs/*.jsonl",
    "job"          = "battery-prediction-api",
    "service_name" = "battery-prediction-api",
  }]
  sync_period = "2s"
}

loki.source.file "api_logs" {
  targets    = local.file_match.api_logs.targets
  forward_to = [loki.process.api_logs.receiver]
}

loki.process "api_logs" {
  stage.json {
    expressions = {
      event  = "event",
      level  = "level",
      route  = "route",
    }
  }

  stage.labels {
    values = {
      event = "",
      level = "",
      route = "",
    }
  }

  forward_to = [loki.write.local.receiver]
}

loki.write "local" {
  endpoint {
    url = "http://loki:3100/loki/api/v1/push"
  }
}

otelcol.receiver.otlp "api_traces" {
  grpc {
    endpoint = "0.0.0.0:4317"
  }

  http {
    endpoint = "0.0.0.0:4318"
  }

  output {
    traces = [otelcol.exporter.otlp.tempo.input]
  }
}

otelcol.exporter.otlp "tempo" {
  client {
    endpoint = "tempo:4317"
    tls {
      insecure = true
    }
  }
}
