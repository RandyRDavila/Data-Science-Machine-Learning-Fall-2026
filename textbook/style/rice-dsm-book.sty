\hypersetup{
  colorlinks=true,
  linkcolor=RiceBlue,
  urlcolor=RiceBlue,
  citecolor=RiceGreen,
  pdftitle={Data Science and Machine Learning: A Systems Approach},
  pdfauthor={Randy Davila},
