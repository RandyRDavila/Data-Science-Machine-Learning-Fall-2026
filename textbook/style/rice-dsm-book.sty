}

\setlength{\parindent}{0pt}
\setlength{\parskip}{0.55em}
\setlist[itemize,enumerate]{nosep,leftmargin=*}
\renewcommand{\arraystretch}{1.2}
\emergencystretch=2em
\raggedbottom

\pagestyle{fancy}
\fancyhf{}
\fancyhead[LE]{\small\color{RiceGray}\thepage\quad\textbar\quad\nouppercase{\leftmark}}
\fancyhead[RO]{\small\color{RiceGray}\nouppercase{\rightmark}\quad\textbar\quad\thepage}
\renewcommand{\headrulewidth}{0.35pt}
\fancypagestyle{plain}{
  \fancyhf{}
  \fancyfoot[C]{\small\color{RiceGray}\thepage}
  \renewcommand{\headrulewidth}{0pt}
}

\titleformat{\chapter}[display]
  {\normalfont\bfseries\color{RiceBlue}}
  {\filleft\Large\MakeUppercase{\chaptertitlename}\ \thechapter}
  {0.6ex}
  {\titlerule[1.2pt]\vspace{1.1ex}\Huge}
\titlespacing*{\chapter}{0pt}{-10pt}{28pt}
\titleformat{\section}{\Large\bfseries\color{RiceBlue}}{\thesection}{0.7em}{}
\titleformat{\subsection}{\large\bfseries\color{RiceGray}}{\thesubsection}{0.7em}{}

\lstdefinestyle{ricepython}{
  language=Python,
  backgroundcolor=\color{CodeBackground},
  basicstyle=\ttfamily\small,
  keywordstyle=\color{CodeKeyword}\bfseries,
  commentstyle=\color{CodeComment}\itshape,
  stringstyle=\color{CodeString},
  showstringspaces=false,
  breaklines=true,
  frame=single,
  rulecolor=\color{RiceGray!35},
  numbers=left,
  numberstyle=\tiny\color{RiceGray},
  numbersep=8pt,
  xleftmargin=1.4em,
  framexleftmargin=1.1em,
  aboveskip=0.9em,
  belowskip=0.9em,
  columns=fullflexible,
  keepspaces=true
}
\lstset{style=ricepython}

